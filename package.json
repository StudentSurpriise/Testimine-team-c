{
  "name": "testimine-praktikum",
  "version": "1.0.0",
  "private": true,
  "description": "Practice project for the Software Systems Testing course: unit tests with Jest, e2e and API tests with Playwright.",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watchAll",
    "coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui-port=8080 --ui-host=0.0.0.0",
    "api": "node server.js",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report --host 0.0.0.0",
    "shop": "node shop-server.js",
    "test:ui": "playwright test --project=ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "express": "^4.21.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
